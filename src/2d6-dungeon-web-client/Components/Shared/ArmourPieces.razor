@rendermode InteractiveServer

@if(armourPiece != null){
    <FluentDataGrid Items="@pieces" style="width: 100%;" MultiLine="true">
        <PropertyColumn Title="ARMOUR PIECE" Property="@(a => a.Name)" Sortable="false" />
        <TemplateColumn Title="DICESET" >
            @foreach(var part in context.DiceSet.Split('+')) {
                if(part.Contains("-")) {
                    <Dice color="Dice.DiceColor.white" size="Dice.DiceSize.tiny" diceset="@part.Trim()" />
                } else {
                    <Dice color="Dice.DiceColor.white" size="Dice.DiceSize.tiny" face="@int.Parse(part.Trim())" />
                }
                if (part != context.DiceSet.Split('+').Last()) {
                    <span> + </span>
                }
            }
        </TemplateColumn>
        <PropertyColumn Title="MODIFIER" Property="@(a => a.Modifier)" Sortable="false"/>
    </FluentDataGrid>

}

@code {

    [Parameter]
    public List<ArmourPiece>? armourPiece { get; set; }
    
    IQueryable<ArmourPiece>? pieces;
    
    protected override void OnInitialized()
    {
        pieces = armourPiece?.AsQueryable();
    }

}
