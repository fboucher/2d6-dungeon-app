@using c5m._2d6Dungeon;
@inject D6Service D6Service;
@inject NavigationManager Navigation;
@inject IDialogService DialogService

@rendermode InteractiveServer

<h3>Create an Adventurer</h3>

<EditForm Model="@ParentAdventurer">

<FluentStack Orientation="Orientation.Vertical">
    <FluentCard>
        <div class="card-header" style="height: 18px;">Adventurer Details</div>
        <FluentTextInput    Label="Name"
                            Required="true"
                            Immediate="true"
                            @bind-Value="ParentAdventurer!.Name"></FluentTextInput>
    </FluentCard>


    <FluentCard>
        <div class="card-header" style="height: 18px;">Weapon</div>

        <FluentCombobox TOption="Weapon" TValue="Weapon"
                        Items=@(weapons?.value ?? new List<Weapon>())
                        Appearance="ListAppearance.FilledDarker"
                        Label="Weapons"
                        Multiple=false
                        Required="true"
                        OptionText="@(w => w?.Name ?? string.Empty)"
                        Value="@selectedWeapon"
                        ValueChanged="@( (Weapon? w) => WeaponSelected(w!))"
                        Disabled="@isSwitchWeaponPossible"
                        Placeholder="Select a Weapon"
                        />

    </FluentCard>


    <FluentCard Height="200px">
        <div class="card-header" style="height: 18px;">Manoeuvres</div>
        <FluentText Block="true">Choose up to two manoeuvres for your selected weapon: @weaponName</FluentText>
        @* v5 FluentSelect has no "Open" parameter: a FluentListbox keeps the list always visible, as before. *@
        <FluentListbox  TOption="WeaponManoeuvre" TValue="WeaponManoeuvre"
                        Items=@manoeuvresQueryable
                        Label="Manoeuvres (description | modifier | dice set)"
                        Multiple=true
                        Height="100px"
                        Width="400px"
                        Required="true"
                        OptionText="@(m => m == null ? string.Empty : m.Description + " | " + m.Modifier  + " | " + m.DiceSet)"
                        SelectedItems="@(selectedManoeuvres ?? Enumerable.Empty<WeaponManoeuvre>())"
                        SelectedItemsChanged = "@( (IEnumerable<WeaponManoeuvre> selMans) => SelectManoeuvre(selMans))"
                        Id="selManoeuvres"
                        />

    </FluentCard>

    <FluentCard>
        <div class="card-header" style="height: 18px;">Armour Piece</div>
        <FluentCombobox TOption="ArmourPiece" TValue="ArmourPiece"
                        Items=@armourPiecesQueryable
                        Appearance="ListAppearance.FilledDarker"
                        @bind-Value=@selectedArmour
                        Label="Armour Piece (name | modifier | dice set)"
                        Multiple=false
                        Required="true"
                        Width="100%"
                        OptionText="@(a => a == null ? string.Empty : a.Name + " | " + a.Modifier  + " | " + a.DiceSet)"
                        Placeholder="Select an Armour Piece"
                        />
    </FluentCard>


    <FluentCard>
        <div class="card-header" style="height: 18px;">Magic Scroll</div>
        <FluentCombobox     TOption="MagicScroll" TValue="MagicScroll"
                            Items=@magicScollsQueryable
                            Label="Magic Scroll (type | description)"
                            Placeholder="Select a Magic Scroll"
                            Appearance="ListAppearance.FilledDarker"
                            Multiple=false
                            Required="true"
                            Width="100%"
                            OptionText="@(s => s == null ? string.Empty : s.ScrollType + " | " + s.Description)"
                            ValueChanged = "@( (MagicScroll? s) => SelectMagicScroll(s!))"
                            />
    </FluentCard>


    <FluentButton @onclick="CreateAndSaveAdventurer" Appearance="ButtonAppearance.Primary">Save Adventurer</FluentButton>

    @if (saveAttempted && creationErrors.Count > 0)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentText Block="true" Color="Color.Error">Before saving:</FluentText>
            @foreach (var error in creationErrors)
            {
                <FluentText Block="true" Color="Color.Error">@error</FluentText>
            }
        </FluentStack>
    }

</FluentStack>

</EditForm>
<br /><br /><br />

@code {

    [Parameter] public Game.Adventurer? ParentAdventurer {get; set;}
    [Parameter] public EventCallback<Game.Adventurer> ParentAdventurerChanged { get; set; }

    private WeaponList? weapons = new WeaponList();
    private int selectedWeaponId = 1;
    private Weapon? selectedWeapon;
    protected string? selectedArmourId;
    protected ArmourPiece? selectedArmour;
    private int selectedMagicScrollId = 0;
    private string weaponName = string.Empty;
    private IQueryable<WeaponManoeuvre>? manoeuvresQueryable = new List<WeaponManoeuvre>().AsQueryable();
    private List<ArmourPiece>? armourPiecesQueryable;
    private List<MagicScroll>? magicScollsQueryable;
    private IEnumerable<WeaponManoeuvre>? selectedManoeuvres;
    private bool isSwitchWeaponPossible = false;

    private bool warningShowed = false;

    // Shown under the Save button once the user has tried to save, then kept live as they fix things
    private List<string> creationErrors => BuildCandidate().GetCreationErrors();
    private bool saveAttempted = false;


    protected override async Task OnInitializedAsync()
    {

        try{
            ParentAdventurer = new Game.Adventurer();
            weapons = await D6Service.GetWeapons();

            armourPiecesQueryable = (await D6Service.GetInitialArmourPieces()).value;
            magicScollsQueryable = (await D6Service.GetInitialMagicScrolls()).value;

        }
        catch(Exception ex){
            Console.WriteLine("Oops1 --> " + ex.Message);
        }
    }


    private async Task WeaponSelected(Weapon weapon)
    {
        if(weapon is null){
            return;
        }
        try{
            selectedWeaponId = weapon.Id;
            selectedWeapon = weapons?.value?.FirstOrDefault(w => w.Id == selectedWeaponId);
            if(selectedWeaponId > 0){
                weaponName = weapons?.value?.Where(w => w!.Id == selectedWeaponId).Select(w => w.Name).FirstOrDefault()! ;
                var manoeuvres = await D6Service.GetWeaponManoeuvreList(selectedWeaponId, 1);
                manoeuvresQueryable = manoeuvres!.value.AsQueryable();
            }
        }
        catch(Exception ex){
            Console.WriteLine("Oops1 --> " + ex.Message);
        }
    }

    private async Task SelectManoeuvre(IEnumerable<WeaponManoeuvre> selManoeuvres)
    {
        selectedManoeuvres = selManoeuvres.ToList();
        if(selManoeuvres != null && selManoeuvres.Count() > 0){
            isSwitchWeaponPossible = true;
            if(selManoeuvres.Count() > 2){
                await ShowMaxManoeuvresReached();
            }
        }
        else
        {
            isSwitchWeaponPossible = false;
        }
    }

    private async Task ShowMaxManoeuvresReached()
    {
        if(!warningShowed){
            warningShowed = true;
            await DialogService.ShowErrorAsync("Maximum of two weapon manoeuvres");
        }

    }


    private void SelectArmourPiece(int armourPieceId)
    {
        selectedArmourId = armourPieceId.ToString();
    }

    private void SelectMagicScroll(MagicScroll magicScroll)
    {
        if(magicScroll is not null){
           selectedMagicScrollId = magicScroll.Id;
        }
    }
    // The adventurer as it would be saved from the current selections; nothing null is ever added
    private Game.Adventurer BuildCandidate()
    {
        var scroll = magicScollsQueryable?.FirstOrDefault(s => s.Id == selectedMagicScrollId);
        return new Game.Adventurer(ParentAdventurer?.Name ?? string.Empty)
        {
            Weapon = selectedWeapon,
            WeaponManoeuvres = selectedManoeuvres?.Where(m => m is not null).ToList() ?? new List<WeaponManoeuvre>(),
            ArmourPieces = selectedArmour is null ? new List<ArmourPiece>() : new List<ArmourPiece> { selectedArmour },
            MagicScrolls = scroll is null ? new List<MagicScroll>() : new List<MagicScroll> { scroll },
        };
    }

    private async Task CreateAndSaveAdventurer()
    {
        saveAttempted = true;
        var candidate = BuildCandidate();
        if (candidate.GetCreationErrors().Count > 0)
        {
            return;
        }

        MagicPotion InitialPotion = await D6Service.GetInitialMagicPotion();

        ParentAdventurer!.Weapon = candidate.Weapon;
        ParentAdventurer.WeaponManoeuvres = candidate.WeaponManoeuvres;
        ParentAdventurer.ArmourPieces = candidate.ArmourPieces;
        ParentAdventurer.MagicScrolls = candidate.MagicScrolls;
        ParentAdventurer.MagicPotions = new List<MagicPotion> { InitialPotion };

        int createdAdventurerId;
        try
        {
            createdAdventurerId = await D6Service.AdventurerCreate(ParentAdventurer);
        }
        catch (ArgumentException ex)
        {
            await DialogService.ShowErrorAsync(ex.Message);
            return;
        }

        if (createdAdventurerId > 0){
            Navigation.NavigateTo($"theadventure/new/{createdAdventurerId}");
        }

    }
}
