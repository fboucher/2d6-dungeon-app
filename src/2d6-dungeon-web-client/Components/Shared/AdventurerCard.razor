@using c5m._2d6Dungeon;
@inject D6Service D6Service;
@inject IDialogService DialogService;

@rendermode InteractiveServer


@* Fluent UI v5 removed FluentPersona: an avatar with a presence badge, next to the details. *@
<div class="adventurer-persona" @onclick="@(() => ToggleExtended())">
    <FluentPresenceBadge Status="PresenceStatus.Available" Size="BadgeSize.Small" Positioning="Positioning.BelowEnd">
        <AnchorContent>
            <FluentAvatar Name="@(Player.Name)" Size="AvatarSize.Size48" Color="AvatarColor.Brand" />
        </AnchorContent>
    </FluentPresenceBadge>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Width="100%">
            <FluentText As="TextTag.H3">@Player.Name</FluentText>
            <FluentSpacer />
            <FluentText Block="true"><b>Level:</b> @Player.Level</FluentText>
        </FluentStack>

        @if (!Extented)
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="5">
                <FluentText Block="true"><b>HP:</b> @Player.HealthPoints / @Player.MaxHealthPoints</FluentText>
                <FluentSpacer Width="50px" />
                <FluentText Block="true"><b>XP:</b> @Player.XP</FluentText>
            </FluentStack>
        }
    </FluentStack>
</div>
@if (Extented)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5" Width="550px">

        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
            <b>XP:</b>
            <FluentNumberInput @bind-Value="@Player.XP" style="width: 100px;" />
            <FluentNumberInput @bind-Value="@_xpDelta" Min="1" Placeholder="Add XP" style="width: 80px;" />
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@AddXp" IconStart="@(new Icons.Filled.Size16.Add())">Add
            </FluentButton>
            <FluentSpacer Width="50px" />
            <FluentText Block="true"><b>Level:</b>
                <FluentNumberInput @bind-Value="@Player.Level" style="width: 80px;" />
            </FluentText>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5"
                     Width="100%" Wrap="true">
            <FluentText Block="true"><b>HP:</b></FluentText>
            <FluentNumberInput @bind-Value="@Player.HealthPoints" @bind-Value:after="CheckHealth" Max="@Player.MaxHealthPoints" style="width: 80px;" />
            <FluentText Block="true"><b>Max HP:</b></FluentText>
            <FluentNumberInput @bind-Value="@Player.MaxHealthPoints" @bind-Value:after="CheckHealth" Min="1" style="width: 80px;" />
        </FluentStack>

        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5"
                         Width="100%" Wrap="true">
                <FluentText Block="true"><b>SHIFT </b></FluentText> @Player.Shift.ToString()
                <FluentSpacer Width="50px" />

                <FluentText Block="true"><b>Discipline</b></FluentText> @Player.Discipline.ToString()
                <FluentSpacer Width="50px" />

                <FluentText Block="true"><b>Precision</b></FluentText> @Player.Precision.ToString()
            </FluentStack>
        </FluentCard>

        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5"
                         Width="100%" Wrap="true">
                <FluentText Block="true"><b>WEAPON</b></FluentText>
                <FluentText Block="true">@((Player.Weapon?.Name ?? "None"))</FluentText>
                <FluentSpacer Width="50px" />

                <FluentText Block="true"><b>Applied Runes:</b></FluentText>
                <FluentText Block="true">@Player.AppliedRunes.ToString()</FluentText>
            </FluentStack>
        </FluentCard>

            


        
        <FluentCard  Width="90%">
            <div class="sheetTitle"><b>MANOEUVRES</b></div>
            @if (Player.WeaponManoeuvres != null && Player.WeaponManoeuvres.Count > 0)
            {
                @foreach (var weaponManoeuvre in Player.WeaponManoeuvres)
                {
                    <div>
                        <Manoeuvre manoeuvre="@weaponManoeuvre" />
                    </div>
                }
            }
        </FluentCard>

        <FluentCard Width="90%">
            <ArmourPieces armourPiece="@Player.ArmourPieces" OnArmourPiecesChanged="@HandleArmourPiecesChanged" />
        </FluentCard>

        <FluentCard Width="90%" >
            <MagicScrolls magicScrolls="@Player.MagicScrolls" OnScrollDeleted="@HandleScrollDeleted" OnScrollAdded="@HandleScrollAdded" />
        </FluentCard>

        <FluentCard Width="90%">
            <MagicPotions magicPotions="@Player.MagicPotions" OnPotionDeleted="@HandlePotionDeleted" OnPotionAdded="@HandlePotionAdded" />
        </FluentCard>

        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="1">
                <FluentText Block="true">LEGEND STATUS LEVEL TRACKER</FluentText>
                <div class="slider-with-ticks" style="width: 200px;">
                    <FluentSlider Min="0" Max="10" Step="1" @bind-Value="@Player.LegendStatusLevelTracker" Style="width: 100%;" />
                    <SliderTicks Min="0" Max="10" />
                </div>
            </FluentStack>
        </FluentCard>

        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="25">
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="5">
                    <FluentText Block="true" Style="width: 90px;"><b>BLOODIED</b></FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="8" Step="1" @bind-Value="@Player.Bloodied" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="8" />
                    </div>
                    <FluentText Block="true"><b>FEVER -1 HP</b> per room until washed</FluentText>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="5">
                    <FluentText Block="true" Style="width: 90px;"><b>SOAKED</b></FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="8" Step="1" @bind-Value="@Player.Soaked" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="8" />
                    </div>
                    <FluentText Block="true"><b>PNEUMONIA -1 HP</b> per room until heated</FluentText>
                </FluentStack>
            </FluentStack>
        </FluentCard>


        <FluentCard Width="90%">

            <FluentStack Orientation="Orientation.Horizontal" VerticalGap="5">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <div class="sheetTitle"><b>COINS</b></div>
                    @* <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5" Wrap="true"> *@
                    <FluentNumberInput Label="Gold" @bind-Value="@Player.Coins.GoldCoins" Width="100%" />
                    <FluentNumberInput Label="Silver" @bind-Value="@Player.Coins.SilverCoins" Width="100%" />
                    <FluentNumberInput Label="Copper" @bind-Value="@Player.Coins.CupperCoins" Width="100%" />
                    @* </FluentStack> *@
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <FluentText Block="true"><b>TREASURE</b></FluentText>
                    <FluentTextArea @bind-Value="@Player.Treasures" Height="152px" Resize="TextAreaResize.Both"
                                    Placeholder="Treasure Notes" Style="width: 100%;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <FluentText Block="true"><b>LIBERATED PRISONERS</b></FluentText>
                    <FluentNumberInput @bind-Value="@Player.LiberatedPrisoners" style="width: 100%;" />

                    <FluentText Block="true"><b>SIDE QUESTS</b></FluentText>
                    <FluentTextArea @bind-Value="@Player.SideQuests" Height="92px" Resize="TextAreaResize.Both"
                                    Placeholder="Side Quests Notes" Style="width: 100%;" />
                </FluentStack>

            </FluentStack>
        </FluentCard>


        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="25">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 50%;"><b>FAVOUR OF THE GODS</b></FluentText>
                    <FluentText Block="true"><b>FAVOUR POINTS</b></FluentText>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>GRAKADA</b> THE CORE</FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Grakada" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>INTUNERIC</b> THE MURK</FluentText>
                    <div class="slider-with-ticks" style="width: 200px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Intuneric" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>MADUVA</b> THE ROT</FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Maduva" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>MURATAYNIE</b> THE PULP</FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Murataynie" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>NEVAZATOR</b> THE BLIND</FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Nevazator" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                    <FluentText Block="true" Style="Width: 30%;"><b>RADACINA</b> THE RADIX</FluentText>
                    <div class="slider-with-ticks" style="width: 300px;">
                        <FluentSlider Min="0" Max="6" Step="1" @bind-Value="@Player.FavorOfTheGods.Radacina" Style="width: 100%;" />
                        <SliderTicks Min="0" Max="6" />
                    </div>
                </FluentStack>
            </FluentStack>
        </FluentCard>


        <FluentCard Width="90%">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <FluentText Block="true"><b>LARGE AND HEAVY ITEMS</b></FluentText>
                    <FluentListbox TOption="int" TValue="int" Width="300px"
                                 Items="@Enumerable.Range(0, LargeAndHeavyItemDisplayItems.Count)"
                                 OptionText="@(i => LargeAndHeavyItemDisplayItems[i])"
                                 @bind-Value="@_selectedLargeAndHeavyItemIndex">
                    </FluentListbox>
                    <div>
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      OnClick="@OpenEditLargeAndHeavyItemDialog"
                                      IconStart="@(new Icons.Filled.Size16.Edit())"></FluentButton>
                        <FluentButton
                            OnClick="@DeleteSelectedLargeAndHeavyItem"
                            Disabled="@(!CanDeleteSelectedLargeAndHeavyItem())"
                            IconStart="@(new Icons.Filled.Size16.Delete())"></FluentButton>
                    </div>

                    <FluentText Block="true"><b>ADDITIONAL NOTES</b></FluentText>
                    <FluentTextArea @bind-Value="@Player.AdditionalNotes" Height="212px" Resize="TextAreaResize.Both"
                                    Placeholder="Additional Notes" Style="width: 100%;" />

                    <FluentText Block="true"><b>RATIONS</b></FluentText>
                    <FluentNumberInput @bind-Value="@Player.Rations" Min="0" style="width: 120px;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <FluentText Block="true"><b>SMALL ITEMS</b></FluentText>
                    <FluentTextArea @bind-Value="@Player.SmallItems" Height="512px" Resize="TextAreaResize.Both"
                                    Placeholder="Small Items Notes" Style="width: 100%;" />

                    <FluentText Block="true"><b>LOOT LOCKUP</b></FluentText>
                    <FluentTextArea @bind-Value="@Player.LootLockup" Height="132px" Resize="TextAreaResize.Both"
                                    Placeholder="Loot Lockup" Style="width: 100%;" />
                </FluentStack>
            </FluentStack>
        </FluentCard>

        
    </FluentStack>
}

@code {
    [Parameter]
    public required Game.Adventurer Player { get; set; }

    [Parameter]
    public EventCallback<Game.Adventurer> PlayerChanged { get; set; }

    [Parameter]
    public EventCallback OnHealthDepleted { get; set; }

    [Parameter]
    public bool Extented { get; set; } = false;

    [Parameter]
    public bool Editable { get; set; } = false;

    private bool healthDepletionHandled = false;
    private int _xpDelta = 0;
    private int _selectedLargeAndHeavyItemIndex = -1;

    private int SelectedLargeAndHeavyItemIndex => _selectedLargeAndHeavyItemIndex;

    private async Task AddXp()
    {
        if (_xpDelta <= 0) return;
        Player.XP += _xpDelta;
        _xpDelta = 0;
        await PlayerChanged.InvokeAsync(Player);
    }

    private async Task CheckHealth()
    {
        Player.HealthPoints = Math.Min(Player.HealthPoints, Player.MaxHealthPoints);

        if (Player.HealthPoints <= 0 && !healthDepletionHandled)
        {
            healthDepletionHandled = true;
            await OnHealthDepleted.InvokeAsync();
        }
    }

    private async Task HandlePotionDeleted(MagicPotion potion)
    {
        Player.Heal(potion.HealAmount);
        await PlayerChanged.InvokeAsync(Player);
    }

    private async Task HandlePotionAdded(MagicPotion potion)
    {
        @* Player.MagicPotions ??= new List<MagicPotion>();
        Player.MagicPotions.Add(potion); *@
        await PlayerChanged.InvokeAsync(Player);
        StateHasChanged();
    }

    private async Task HandleArmourPiecesChanged(List<ArmourPiece> pieces)
    {
        await PlayerChanged.InvokeAsync(Player);
        StateHasChanged();
    }

    private async Task HandleScrollDeleted(int id)
    {
        await PlayerChanged.InvokeAsync(Player);
    }

    private async Task HandleScrollAdded(MagicScroll scroll)
    {
        await PlayerChanged.InvokeAsync(Player);
        StateHasChanged();
    }

    private void ToggleExtended()
    {
        Extented = !Extented;
    }

    private async Task OpenEditLargeAndHeavyItemDialog()
    {
        if (SelectedLargeAndHeavyItemIndex < 0)
        {
            return;
        }

        var actualItems = GetActualLargeAndHeavyItems();
        var dialogData = new EditLargeAndHeavyItemDialogData
        {
            Text = SelectedLargeAndHeavyItemIndex < actualItems.Count
                ? actualItems[SelectedLargeAndHeavyItemIndex]
                : string.Empty
        };

        var result = await DialogService.ShowDialogAsync<EditLargeAndHeavyItemDialog>(options =>
        {
            options.Header.Title = "Edit Large and Heavy Item";
            options.Footer.PrimaryAction.Label = "Save";
            options.Footer.PrimaryAction.Disabled = string.IsNullOrWhiteSpace(dialogData.Text);
            options.Footer.SecondaryAction.Label = "Cancel";
            options.Width = "420px";
            options.Modal = true;
            options.Parameters.Add(nameof(EditLargeAndHeavyItemDialog.Content), dialogData);
        });

        if (!result.Cancelled && result.GetValue<EditLargeAndHeavyItemDialogData>() is EditLargeAndHeavyItemDialogData resultData)
        {
            SetLargeAndHeavyItemText(SelectedLargeAndHeavyItemIndex, resultData.Text);
            await PlayerChanged.InvokeAsync(Player);
        }
    }

    private async Task DeleteSelectedLargeAndHeavyItem()
    {
        if (!CanDeleteSelectedLargeAndHeavyItem())
        {
            return;
        }

        var actualItems = GetActualLargeAndHeavyItems();
        actualItems.RemoveAt(SelectedLargeAndHeavyItemIndex);
        Player.LargeAndHeavyItems = actualItems;
        _selectedLargeAndHeavyItemIndex = -1;
        await PlayerChanged.InvokeAsync(Player);
    }

    private bool CanDeleteSelectedLargeAndHeavyItem()
    {
        var actualItems = GetActualLargeAndHeavyItems();
         return SelectedLargeAndHeavyItemIndex >= 0
             && SelectedLargeAndHeavyItemIndex < actualItems.Count;
    }

    private List<string> GetActualLargeAndHeavyItems()
    {
        return Player.LargeAndHeavyItems?
                   .Where(item => !string.IsNullOrWhiteSpace(item))
                   .ToList()
               ?? new List<string>();
    }

    private List<string> LargeAndHeavyItemDisplayItems
    {
        get
        {
            var actualItems = GetActualLargeAndHeavyItems();
            var displayItems = new List<string>(actualItems);
            for (int i = actualItems.Count; i < 10; i++)
            {
                displayItems.Add($"{i + 1}.");
            }
            return displayItems;
        }
    }

    private void SetLargeAndHeavyItemText(int index, string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        var actualItems = GetActualLargeAndHeavyItems();
        if (index < actualItems.Count)
        {
            actualItems[index] = text;
        }
        else
        {
            actualItems.Add(text);
        }

        Player.LargeAndHeavyItems = actualItems;
    }

    public void ResetHealthDepletion()
    {
        healthDepletionHandled = false;
    }
}
