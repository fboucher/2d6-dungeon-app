@using c5m._2d6Dungeon;
@inject D6Service D6Service;

@rendermode InteractiveServer


<FluentPersona  Name="@(Player.Name)"
                ImageSize="50px"
                Status="PresenceStatus.Available"
                StatusSize="PresenceBadgeSize.Small"
                OnClick="@(() => ToggleExtended())">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
            <FluentLabel Typo="Typography.H3">@Player.Name</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
                <b>XP:</b>
                <FluentNumberField @bind-Value="@Player.XP" style="width: 80px;" />
                <FluentNumberField @bind-Value="@_xpDelta" Min="1" Placeholder="Add XP" style="width: 80px;" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@AddXp" IconStart="@(new Icons.Filled.Size16.Add())" >Add</FluentButton>
                <FluentSpacer Width="50" />
                <FluentLabel Typo="Typography.Body"><b>Level:</b> <FluentNumberField @bind-Value="@Player.Level" style="width: 80px;" /></FluentLabel>
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5" Width="100%" Wrap="true">
                @if(Editable)
                {
                    <FluentLabel Typo="Typography.Body"><b>Level:</b>HP</FluentLabel> <FluentNumberField @bind-Value="@Player.HealthPoints" @bind-Value:after="CheckHealth" style="width: 80px;" />
                }
                else 
                {
                    <FluentLabel Typo="Typography.Body"><b>HP:</b></FluentLabel> @Player.HealthPoints.ToString()
                }
            </FluentStack>

            <FluentCard  MinimalStyle="true">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5" Width="100%" Wrap="true">
                    <FluentLabel Typo="Typography.Body"><b>SHIFT </b></FluentLabel> @Player.Shift.ToString()
                    <FluentSpacer Width="50" />

                    <FluentLabel Typo="Typography.Body"><b>Discipline</b></FluentLabel> @Player.Discipline.ToString()
                    <FluentSpacer Width="50" />

                    <FluentLabel Typo="Typography.Body"><b>Precision</b></FluentLabel> @Player.Precision.ToString()
                </FluentStack>
            </FluentCard>

            <FluentCard  MinimalStyle="true">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="5" Width="100%" Wrap="true">
                    <FluentLabel Typo="Typography.Body"><b>WEAPON</b></FluentLabel> <FluentLabel Typo="Typography.Body">@((Player.Weapon?.Name ?? "None"))</FluentLabel>
                    <FluentSpacer Width="50" />

                    <FluentLabel Typo="Typography.Body"><b>Applied Runes:</b></FluentLabel> <FluentLabel Typo="Typography.Body">@Player.AppliedRunes.ToString()</FluentLabel>
                </FluentStack>
            </FluentCard>

        </FluentStack>
</FluentPersona>
@if(Extented)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5" Width="100%">
        
        <FluentCard MinimalStyle="true">
            <div class="sheetTitle"><b>MANOEUVRES</b></div>
            @if(Player.WeaponManoeuvres != null && Player.WeaponManoeuvres.Count > 0)
            {
                @foreach(var weaponManoeuvre in Player.WeaponManoeuvres)
                {
                    <div><Manoeuvre manoeuvre="@weaponManoeuvre" /></div>
                }
            }
        </FluentCard>

        <FluentCard MinimalStyle="true">
            <ArmourPieces armourPiece="@Player.ArmourPieces" />
        </FluentCard>

        <FluentCard MinimalStyle="true">
            <MagicScrolls magicScrolls="@Player.MagicScrolls" />
        </FluentCard>

        <FluentCard MinimalStyle="true">
            <MagicPotions magicPotions="@Player.MagicPotions" />
        </FluentCard>

        <FluentCard MinimalStyle="true">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="25">
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="5">
                    <FluentLabel Typo="Typography.Body"><b>BLOODIED</b></FluentLabel>
                    <FluentSlider Min="0" Max="8" Step="1" @bind-Value="@Player.Bloodied" Style="width: 350px;" >
                        <FluentSliderLabel Position="0">0</FluentSliderLabel>
                        <FluentSliderLabel Position="1">1</FluentSliderLabel>
                        <FluentSliderLabel Position="2">2</FluentSliderLabel>
                        <FluentSliderLabel Position="3">3</FluentSliderLabel>
                        <FluentSliderLabel Position="4">4</FluentSliderLabel>
                        <FluentSliderLabel Position="5">5</FluentSliderLabel>
                        <FluentSliderLabel Position="6">6</FluentSliderLabel>
                        <FluentSliderLabel Position="7">7</FluentSliderLabel>
                        <FluentSliderLabel Position="8">8</FluentSliderLabel>
                    </FluentSlider>
                    <FluentLabel Typo="Typography.Body"><b>FEVER -1 HP</b> per room until washed</FluentLabel>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="5">
                    <FluentLabel Typo="Typography.Body"><b>SOAKED</b></FluentLabel>
                    <FluentSlider Min="0" Max="8" Step="1" @bind-Value="@Player.Soaked"  Style="width: 350px;" >
                        <FluentSliderLabel Position="0">0</FluentSliderLabel>
                        <FluentSliderLabel Position="1">1</FluentSliderLabel>
                        <FluentSliderLabel Position="2">2</FluentSliderLabel>
                        <FluentSliderLabel Position="3">3</FluentSliderLabel>
                        <FluentSliderLabel Position="4">4</FluentSliderLabel>
                        <FluentSliderLabel Position="5">5</FluentSliderLabel>
                        <FluentSliderLabel Position="6">6</FluentSliderLabel>
                        <FluentSliderLabel Position="7">7</FluentSliderLabel>
                        <FluentSliderLabel Position="8">8</FluentSliderLabel>
                    </FluentSlider>
                    <FluentLabel Typo="Typography.Body"><b>PNEUMONIA -1 HP</b> per room until heated</FluentLabel>
                </FluentStack>
            </FluentStack>
        </FluentCard>



        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <div class="sheetTitle"><b>RESOURCES</b></div>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                    <span><span class="sheetTitle">Rations:</span> @Player.Rations.ToString()</span>
                    
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <div class="sheetTitle"><b>CURRENCY</b></div>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                    <span><span class="sheetTitle">Gold:</span> @Player.Coins.GoldCoins.ToString()</span>
                    <span><span class="sheetTitle">Silver:</span> @Player.Coins.SilverCoins.ToString()</span>
                    <span><span class="sheetTitle">Copper:</span> @Player.Coins.CupperCoins.ToString()</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <div class="sheetTitle"><b>QUEST PROGRESS</b></div>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="3">
                    <span><span class="sheetTitle">Legend Status Level Tracker:</span> @Player.LegendStatusLevelTracker.ToString()</span>
                    <span><span class="sheetTitle">Liberated Prisoners:</span> @Player.LiberatedPrisoners.ToString()</span>
                    @if (Player.Treasures != null && Player.Treasures.Count > 0)
                    {
                        <div>
                            <span class="sheetTitle">Treasures:</span>
                            <ul style="margin: 5px 0; padding-left: 20px;">
                                @foreach(var treasure in Player.Treasures)
                                {
                                    <li>@treasure</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (Player.SideQuests != null && Player.SideQuests.Count > 0)
                    {
                        <div>
                            <span class="sheetTitle">Side Quests:</span>
                            <ul style="margin: 5px 0; padding-left: 20px;">
                                @foreach(var quest in Player.SideQuests)
                                {
                                    <li>@quest</li>
                                }
                            </ul>
                        </div>
                    }
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <div class="sheetTitle"><b>FAVOR OF THE GODS</b></div>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                    <span><span class="sheetTitle">Grakada:</span> @Player.FavorOfTheGods.Grakada.ToString()</span>
                    <span><span class="sheetTitle">Intuneric:</span> @Player.FavorOfTheGods.Intuneric.ToString()</span>
                    <span><span class="sheetTitle">Maduva:</span> @Player.FavorOfTheGods.Maduva.ToString()</span>
                    <span><span class="sheetTitle">Murataynie:</span> @Player.FavorOfTheGods.Murataynie.ToString()</span>
                    <span><span class="sheetTitle">Nevazator:</span> @Player.FavorOfTheGods.Nevazator.ToString()</span>
                    <span><span class="sheetTitle">Radacina:</span> @Player.FavorOfTheGods.Radacina.ToString()</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>

        





        
    </FluentStack>
}

@code {
    [Parameter]
    public required Game.Adventurer Player { get; set; }

    [Parameter] 
    public EventCallback<Game.Adventurer> PlayerChanged { get; set; }

    [Parameter]
    public EventCallback OnHealthDepleted { get; set; }

    [Parameter]
    public bool Extented { get; set; } = false;

    [Parameter]
    public bool Editable { get; set; } = false;

    private bool healthDepletionHandled = false;
    private int _xpDelta = 0;

    private async Task AddXp()
    {
        if (_xpDelta <= 0) return;
        Player.XP += _xpDelta;
        _xpDelta = 0;
        await PlayerChanged.InvokeAsync(Player);
    }

    private async Task CheckHealth()
    {
        if (Player.HealthPoints <= 0 && !healthDepletionHandled)
        {
            healthDepletionHandled = true;
            await OnHealthDepleted.InvokeAsync();
        }
    }

    private void ToggleExtended()
    {
        Extented = !Extented;
    }

    public void ResetHealthDepletion()
    {
        healthDepletionHandled = false;
    }
}
