@inherits AppDialogBase<EditAdventureNameDialogData>
@rendermode InteractiveServer

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" style="min-width: 360px;">
        <FluentTextInput Label="Adventure Name"
                         Value="@Content.Name"
                         ValueChanged="@OnNameChanged"
                         Placeholder="Type the new adventure name" />
    </FluentStack>
</FluentDialogBody>

@code {
    protected override void OnInitialized()
    {
        TogglePrimaryActionButton(!string.IsNullOrWhiteSpace(Content.Name));
    }

    private void OnNameChanged(string? value)
    {
        Content.Name = value ?? string.Empty;
        TogglePrimaryActionButton(!string.IsNullOrWhiteSpace(Content.Name));
    }
}
