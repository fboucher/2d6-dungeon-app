@inherits AppDialogBase<EditLargeAndHeavyItemDialogData>
@rendermode InteractiveServer

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" style="min-width: 360px;">
        <FluentTextInput Label="Item text"
                         Value="@Content.Text"
                         ValueChanged="@OnTextChanged"
                         Placeholder="Type the large or heavy item text" />
    </FluentStack>
</FluentDialogBody>

@code {
    protected override void OnInitialized()
    {
        TogglePrimaryActionButton(!string.IsNullOrWhiteSpace(Content.Text));
    }

    private void OnTextChanged(string? value)
    {
        Content.Text = value ?? string.Empty;
        TogglePrimaryActionButton(!string.IsNullOrWhiteSpace(Content.Text));
    }
}
