@using c5m._2d6Dungeon
@inject D6Service D6Service

@inherits AppDialogBase<MagicPotion>

@rendermode InteractiveServer

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" style="width: 100%;">
        @if (potions == null)
        {
            <FluentSpinner />
        }
        else
        {
            <FluentListbox TOption="MagicPotion" TValue="MagicPotion"
                           Items="@potions"
                           OptionText="@(p => p == null ? string.Empty : string.IsNullOrEmpty(p.Modifier) ? p.PotionType : $"{p.PotionType} | {p.Modifier}")"
                           ValueChanged="@OnSelectionChanged"
                           Width="100%"
                           Height="400px" />
        }
    </FluentStack>
</FluentDialogBody>

@code {
    private List<MagicPotion>? potions;

    protected override async Task OnInitializedAsync()
    {
        potions = await D6Service.GetMagicPotions();
        TogglePrimaryActionButton(false);
    }

    private void OnSelectionChanged(MagicPotion? potion)
    {
        if (potion != null)
        {
            Content.Id = potion.Id;
            Content.PotionType = potion.PotionType;
            Content.Modifier = potion.Modifier;
            Content.Duration = potion.Duration;
            Content.Cost = potion.Cost;
        }
        TogglePrimaryActionButton(potion != null);
    }
}
