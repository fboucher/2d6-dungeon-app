@rendermode InteractiveServer

@* Fluent UI v5's FluentNav has no built-in "icons only" rail, so the collapsed state is done with CSS (see .navmenu in app.css). *@
<div class="navmenu @(expanded ? "expanded" : "collapsed")">
    <FluentButton Appearance="ButtonAppearance.Transparent" Class="navmenu-toggle"
                  IconStart="@(new Icons.Regular.Size20.Navigation())"
                  Title="Menu expand/collapse toggle"
                  OnClick="@(() => expanded = !expanded)" />
    <FluentNav Id="main-menu" Width="@(expanded ? "250px" : "40px")">
        <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.HomePerson())" Tooltip="Home">Home</FluentNavItem>
        <FluentNavItem Href="/documentation" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.BookOpen())" Tooltip="Documentation">Documentation</FluentNavItem>
        <FluentNavItem Href="/settings" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.TextBulletListSquareSettings())" Tooltip="Settings">Settings</FluentNavItem>
        <FluentNavItem Href="/about" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Info())" Tooltip="About">About</FluentNavItem>
    </FluentNav>
</div>

@code {
    private bool expanded = false;
}
