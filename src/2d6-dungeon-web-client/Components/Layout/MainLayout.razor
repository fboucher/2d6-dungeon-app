@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Extensions

<FluentLayout>
    <FluentHeader>
        <a href="/" style="display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none;">
            <img src="images/icon-1024.png" alt="2d6 Dungeon" style="height: 28px; width: 28px; border-radius: 4px;" />
            <span>2d6 Dungeon App</span>
        </a>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <a href="https://github.com/fboucher/NoteBookmark" target="_blank">See the code</a>
        <FluentSpacer />
        <a href="https://fboucheros.com" target="_blank">About Frank</a>
        &nbsp;&nbsp;·&nbsp;&nbsp;@AppVersion.Display
    </FluentFooter>
</FluentLayout>

<FluentDialogProvider @rendermode="RenderMode.InteractiveServer" />
<FluentToastProvider  @rendermode="RenderMode.InteractiveServer" />
<FluentMenuProvider   @rendermode="RenderMode.InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>


@code {
    public DesignThemeModes Mode { get; set; }
    public OfficeColor? OfficeColor { get; set; }
    public string? CustomColor { get; set; }
}