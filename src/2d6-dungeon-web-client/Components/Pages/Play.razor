@page "/play/{AdventureId:int}"
@using c5m._2d6Dungeon
@using c5m._2d6Dungeon.web.Domain;
@inject D6Service d6Service;
@inject IJSRuntime JSRuntime;
@inject IDialogService DialogService;
@inject IToastService ToastService;

@rendermode InteractiveServer

<PageTitle>Play</PageTitle>

<FluentButton @onclick="@( () => SaveAventure())" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Save())" />

@if (currentAdventure == null)
{
    <FluentProgressRing Style="margin: 20px;" />
    <p style="margin: 20px;">Loading adventure...</p>
}
else
{
    <FluentTabs @bind-ActiveTabId="@activeid" OnTabChange="HandleOnTabChange">


        <FluentTab Id="tab-map" Label="Dungeon Map" Icon="@(new Icons.Regular.Size24.Map())">
        <FluentStack Orientation="Orientation.Vertical">

            <FluentAccordion  OnAccordionItemChange="HandleOnAccordionItemChange" Style="width: 100%;">
                <FluentAccordionItem Heading="Current Room Details" Expanded="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ConferenceRoom())" Color="@Color.Neutral"
                        Slot="start" />
                    <FluentStack Orientation="Orientation.Horizontal">
                        <div>
                            <FluentLabel Typo="Typography.H4">Room:</FluentLabel> @currentRoom!.Description
                            <FluentLabel Typo="Typography.Body">@gameTurnInstructions</FluentLabel> 
                        </div>
                        <div>
                            <FluentLabel Typo="Typography.H4">Encounter:</FluentLabel> @(string.IsNullOrEmpty(currentRoom!.Encounter) ? "None" : currentRoom!.Encounter)
                        </div>
                    </FluentStack>
                    
                </FluentAccordionItem>
            </FluentAccordion>

            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton @onclick=RollDice Appearance="Appearance.Accent" disabled="@(isRollDiceDisable)">Roll
                    Dice</FluentButton>
                <FluentButton @onclick=PickADoor Appearance="Appearance.Accent">Pick a Door</FluentButton>
            </FluentStack>

            <div style="padding:20px;">
                @if (diceResult.PrimaryDice != 0)
                {
                    <Dice color="Dice.DiceColor.red" size="Dice.DiceSize.regular" face="@diceResult.PrimaryDice" Animate="true" />

                }
                @if (diceResult.SecondaryDice != 0)
                {
                    <Dice color="Dice.DiceColor.purple" size="Dice.DiceSize.regular" face="@diceResult.SecondaryDice" Animate="true" />
                }
            </div>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">

                <div style="position: relative;">
                    <canvas id="dotCanvas" style="width: 800px; height: 800px;"></canvas>

                    <!-- Legend Floating Button -->
                    <button class="legend-floating-btn" @onclick="ToggleLegendPanel" title="Show door legend">
                        Legend
                    </button>

                    <!-- Legend Panel -->
                    @if (isLegendVisible)
                    {
                        <div class="legend-panel" style="max-height: 500px; overflow-y: auto;">
                            <div class="legend-panel-header">
                                <span class="legend-panel-title">Legend</span>
                                <button class="legend-panel-close" @onclick="ToggleLegendPanel" title="Close legend">&#10005;</button>
                            </div>
                            <div class="legend-section-title">Doors</div>
                            <div class="legend-item">
                                <canvas id="legend-archway" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Archway</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-wooden" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Wooden Door</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-metal" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Metal Door</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-reinforced" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Reinforced Door</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-curtain" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Curtain</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-portcullis" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Portcullis</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-stone_slab" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Stone Slab</span>
                            </div>
                            <div class="legend-section-title">Rooms</div>
                            <div class="legend-item">
                                <canvas id="legend-standard-room" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Standard Room</span>
                            </div>
                            <div class="legend-item">
                                <canvas id="legend-unique-room" class="legend-canvas" width="80" height="80"></canvas>
                                <span class="legend-label">Unique Room</span>
                            </div>
                        </div>
                    }
                </div>

                <div id="maps-menu" style="position: sticky; top: 20px; align-self: flex-start;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" >

                        <FluentButton @onclick=RefreshCanvas Appearance="Appearance.Accent" disabled="@(nextRoom != null)">Refresh Canvas</FluentButton>

                        <!-- Viewport Pan Controls -->
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Pan Map View</FluentLabel>
                        <div style="width: 110px;">
                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                <FluentButton @onclick="@( () => PanMap("left"))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronLeft())" Title="Pan left (←)" />
                                <FluentStack Orientation="Orientation.Vertical">
                                    <FluentButton @onclick="@( () => PanMap("up"))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronUp())" Title="Pan up (↑)" />
                                    <FluentButton @onclick="@( () => PanMap("down"))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronDown())" Title="Pan down (↓)" />
                                </FluentStack>
                                <FluentButton @onclick="@( () => PanMap("right"))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronRight())" Title="Pan right (→)" />
                            </FluentStack> 
                        </div>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                            <FluentButton @onclick=CenterOnCurrentRoom Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Location())" Title="Center on current room">Center</FluentButton>
                            <FluentButton @onclick=ResetPan Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Title="Reset view to origin">Reset</FluentButton>
                        </FluentStack>
                        <FluentLabel Color="@Color.Disabled" Style="font-size: 11px;">Use arrow keys or buttons to pan. Move ~2 squares at a time.</FluentLabel>
                        
                        <FluentDivider Style="margin: 10px 0;" />

                        <!-- Room Edit Controls -->
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Room Controls</FluentLabel>
                        @if (isEditingRoom)
                        {
                            <div style="width: 100px;">
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                    <FluentButton @onclick="@( () => MoveRoom("LEFT"))" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.ArrowLeft())" Title="Move room left" />
                                    <FluentStack Orientation="Orientation.Vertical">
                                        <FluentButton @onclick="@( () => MoveRoom("UP"))" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.ArrowUp())" Title="Move room up" />
                                        <FluentButton @onclick="@( () => MoveRoom("DOWN"))" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.ArrowDown())" Title="Move room down" />
                                    </FluentStack>
                                    <FluentButton @onclick="@( () => MoveRoom("RIGHT"))" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.ArrowRight())" Title="Move room right" />
                                </FluentStack> 
                            </div>
                            <FluentLabel Color="@Color.Info" Style="font-size: 11px;">Room is in edit mode. Use the arrows above to reposition the room, and the door rows below to slide each door along its wall.</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Size</FluentLabel>
                            @if (currentRoom != null)
                            {
                                var widthRange = currentRoom.GetWidthRange();
                                var heightRange = currentRoom.GetHeightRange();
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
                                    <span style="width: 45px;">Width</span>
                                    <FluentButton @onclick="@( () => ResizeRoom(-1, 0))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Subtract())" Title="Narrower" disabled="@(currentRoom.Width <= widthRange.Min)" />
                                    <span>@currentRoom.Width</span>
                                    <FluentButton @onclick="@( () => ResizeRoom(1, 0))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Add())" Title="Wider" disabled="@(currentRoom.Width >= widthRange.Max)" />
                                </FluentStack>
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
                                    <span style="width: 45px;">Height</span>
                                    <FluentButton @onclick="@( () => ResizeRoom(0, -1))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Subtract())" Title="Shorter" disabled="@(currentRoom.Height <= heightRange.Min)" />
                                    <span>@currentRoom.Height</span>
                                    <FluentButton @onclick="@( () => ResizeRoom(0, 1))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Add())" Title="Taller" disabled="@(currentRoom.Height >= heightRange.Max)" />
                                </FluentStack>
                            }
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Doors</FluentLabel>
                            @foreach (var wall in doorWalls)
                            {
                                var doorIssues = GetDoorIssues();
                                var aWall = wall;
                                bool hasDoor = currentRoom?.Exits != null && currentRoom.Exits.ContainsKey(aWall);
                                var wallIssue = doorIssues.FirstOrDefault(i => i.Wall == aWall);
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
                                    <span style="width: 45px;">@aWall</span>
                                    @if (hasDoor)
                                    {
                                        <FluentButton @onclick="@( () => MoveDoor(aWall, -1))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronLeft())" Title="@($"Move {aWall} door back")" />
                                        <span>@currentRoom!.Exits![aWall].PositionOnWall / @GetWallLength(aWall)</span>
                                        <FluentButton @onclick="@( () => MoveDoor(aWall, 1))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.ChevronRight())" Title="@($"Move {aWall} door forward")" />
                                        @if (currentRoom!.CanRemoveDoor(aWall))
                                        {
                                            <FluentButton @onclick="@( () => RemoveDoor(aWall))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Delete())" Title="@($"Remove {aWall} door")" />
                                        }
                                        else
                                        {
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Link())" Title="Connected door" />
                                        }
                                    }
                                    else
                                    {
                                        <FluentLabel Color="@Color.Disabled">no door</FluentLabel>
                                        <FluentButton @onclick="@( () => AddDoor(aWall))" Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Add())" Title="@($"Add a door on the {aWall} wall")" />
                                    }
                                    @if (wallIssue != null)
                                    {
                                        <FluentIcon Value="@(new Icons.Filled.Size16.Warning())" Color="@Color.Warning" Title="@wallIssue.Message" />
                                    }
                                </FluentStack>
                            }
                            @if (!string.IsNullOrEmpty(doorErrorMessage))
                            {
                                <FluentLabel Color="@Color.Error" Style="font-size: 11px; white-space: pre-line;">@doorErrorMessage</FluentLabel>
                            }
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                                <FluentButton @onclick=EditRoom Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Checkmark())">Done Editing</FluentButton>
                                <FluentButton @onclick=CancelEditingRoom Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size16.Dismiss())">Cancel</FluentButton>
                            </FluentStack>
                        }
                        else
                        {
                            <FluentLabel Color="@Color.Disabled" Style="font-size: 11px;">Click Edit Room to reposition the current room or adjust its doors.</FluentLabel>
                            <FluentButton @onclick=EditRoom 
                                          Appearance="Appearance.Accent" 
                                          IconStart="@(new Icons.Regular.Size16.TargetEdit())" 
                                          disabled="@(currentRoom == null)">Edit Room</FluentButton>
                        }
                    </FluentStack>
                </div>
            </FluentStack>
        </FluentStack>

    </FluentTab>


    <FluentTab Id="tab-adventurer" Label="Adventurer" Icon="@(new Icons.Regular.Size24.NotepadPerson())">
        <AdventurerCard @bind-Player="currentAdventure!.Adventurer" Extented="true"></AdventurerCard>
    </FluentTab>


    <FluentTab Id="tab-combat" Label="Combat Screen" Icon="@(new Icons.Regular.Size24.Shield())">
        <Combat @bind-CombatState="currentAdventure!.CombatState" OnJournalLog="AppendJournalEntry"></Combat>
    </FluentTab>

    <FluentTab Id="tab-tables" Label="Tables" Icon="@(new Icons.Regular.Size24.Table())">
        <TableViewer />
    </FluentTab>


    <FluentTab Id="tab-note" Label="Game Notes" Icon="@(new Icons.Regular.Size24.ArchiveSettings())">

        <FluentTextArea @bind-Value=@currentAdventure!.Notes Label="Notes:" Rows="15" style="width: 100%;height: 100%;"/>
    </FluentTab>

    <FluentTab Id="tab-journal" Label="Game Journal" Icon="@(new Icons.Regular.Size24.Book())">

        <FluentTextArea @bind-Value=@currentAdventure!.Journal Label="Journal:" Rows="15" style="width: 100%;height: 100%;"/>
    </FluentTab>

</FluentTabs>
}


@code {

    private int _adventureId;

    [Parameter]
    public int AdventureId { get => _adventureId; set => _adventureId = value; }
    private Adventure? currentAdventure;
    MappedRoom? currentRoom = new MappedRoom();
    MappedRoom? nextRoom = null;
    private bool isEditingRoom = false;
    private MappedRoom? roomSnapshot = null;
    private string? doorErrorMessage = null;
    DiceResult diceResult = new DiceResult();

    bool isRollDiceDisable = false;
    string? activeid = "tab-map";
    FluentTab? changedto;
    private bool hasInitializedCanvas = false;

    private string gameTurnInstructions = String.Empty;
    private GameTurn? gameTurn;

    private bool isLegendVisible = false;

    private async Task ToggleLegendPanel()
    {
        isLegendVisible = !isLegendVisible;
        if (isLegendVisible)
        {
            // Allow DOM to render canvases before drawing
            await Task.Yield();
            await DrawLegendIcons();
        }
    }

    private async Task DrawLegendIcons()
    {
        string[] doorTypes = new[] { "archway", "wooden", "metal", "reinforced", "curtain", "portcullis", "stone_slab" };
        foreach (var type in doorTypes)
        {
            await JSRuntime.InvokeVoidAsync("drawLegendDoor", $"legend-{type}", type);
        }
        await JSRuntime.InvokeVoidAsync("drawLegendRoom", "legend-standard-room", false);
        await JSRuntime.InvokeVoidAsync("drawLegendRoom", "legend-unique-room", true);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            //gameTurn = new GameTurn(d6Service);
            gameTurn = new GameTurn();
            gameTurn.d6Service = d6Service;

            if(AdventureId > 0)
            {
                currentAdventure = await d6Service.GetAdventure(AdventureId);
                currentAdventure.CombatState = new CombatState(currentAdventure.Adventurer);
                currentRoom = currentAdventure.Dungeon.GetRooms().Where<MappedRoom>(room => room.YouAreHere == true).First<MappedRoom>();
                if (currentRoom.IsLobby)
                {
                    gameTurnInstructions = "You are in the lobby, you can go anywhere!";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Oops! --> " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentAdventure != null && !hasInitializedCanvas)
        {
            hasInitializedCanvas = true;
            await MapTools.RefreshCanvas(JSRuntime);
            await FillCanvas();
        }
    }

    private void HandleOnTabChange(FluentTab tab)
    {
        changedto = tab;
    }


    private void RollDice()
    {
        var dResult = DiceResult.Roll2Dice();
    }

    private async Task PickADoor()
    {
        if (isEditingRoom && !await StopEditingRoom())
        {
            return;
        }

        Direction? directionTo = await OpenSelectDoorDialogDialogAsync();
        if(directionTo is not null){
            var exit = currentRoom!.Exits![directionTo.Value];

            if (exit.IsLocked)
            {
                var dialogData = new ResolveLockedDoorDialogData
                {
                    Exit = exit,
                    Adventure = currentAdventure!,
                    Direction = directionTo.Value
                };

                DialogParameters parameters = new()
                {
                    Title = $"Locked Door",
                    PrimaryAction = "Close",
                    PrimaryActionEnabled = true,
                    Width = "800px",
                    TrapFocus = true,
                    Modal = true
                };

                IDialogReference dialog = await DialogService.ShowDialogAsync<ResolveLockedDoorDialog>(dialogData, parameters);
                DialogResult? result = await dialog.Result;

                await SaveAventure();
                await RefreshCanvas();

                if (dialogData.CombatInitiated)
                {
                    activeid = "tab-combat";
                    StateHasChanged();
                }
                return;
            }

            if (exit.TargetRoomId > 0)
            {
                var destinationRoom = currentAdventure!.Dungeon.GetRoom(exit.TargetRoomId.Value);
                if (destinationRoom is null)
                {
                    ToastService.ShowToast(ToastIntent.Warning, "Destination room could not be found.");
                    return;
                }
                currentAdventure!.Dungeon.ChangeRoom(currentRoom!, destinationRoom);
                currentAdventure.AppendRoomEntryJournal(destinationRoom);
                currentRoom = destinationRoom;
                gameTurnInstructions = "You already visited that room, Pick another door!";
                await RefreshCanvas();
                return;
            }
            else if (exit.TargetRoomId == -1)
            {
                gameTurnInstructions = "If you go there you will get out of the dungeon!";
                //TODO: We should manage that better
                return;
            }

            Direction directionFrom = GameTurn.GetOppositeDirection(directionTo.Value);
            var (doorX, doorY) = MapTools.GetDoorGridPosition(currentRoom!, directionTo.Value);
            var newRoomId = await OpenNewRoomDialog(directionFrom, doorX, doorY, exit.ExitType);
            if (newRoomId is not null && newRoomId > 0)
            {
                exit.TargetRoomId = newRoomId;
                gameTurnInstructions = "Proceed with the encounter";
                await AddRoomToDungeon();
            }
        }
            
    }
    private async Task<Direction?> OpenSelectDoorDialogDialogAsync()
    {
        DialogParameters parameters = new()
            {
                Title = $"To get out of the current room you have {currentRoom!.ExitsCount} options.",
                PrimaryAction = "Open",
                PrimaryActionEnabled = false,
                SecondaryAction = "Cancel",
                Width = "500px",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };

        var possibleExits = new DoorSelections(currentRoom.Exits!);


        IDialogReference dialog = await DialogService.ShowDialogAsync<SelectDoorDialog>(possibleExits, parameters);
        DialogResult? result = await dialog.Result;

        if (!result.Cancelled && result.Data != null)
        {
            DoorSelections dSelect = (DoorSelections)result.Data;
            Direction goingTo = dSelect.SelectedExit!.Direction;
            return goingTo;
        }
        else
            return null;            
    }

    private async Task<int?> OpenNewRoomDialog(Direction directionFrom, int entranceDoorX, int entranceDoorY, string? entranceDoorType)
    {
        DialogParameters parameters = new()
            {
                Title = $"Let's see what room you are getting in!",
                PrimaryAction = "Save",
                PrimaryActionEnabled = false,
                SecondaryAction = "Cancel", 
                Width = "800px",
                TrapFocus = true,
                Modal = true
            };

        nextRoom = currentAdventure!.Dungeon.GetNewRoom();

        var dialogData = new NewRoomDialogData 
        { 
            Room = nextRoom, 
            Dungeon = currentAdventure!.Dungeon 
        };

        IDialogReference dialog = await DialogService.ShowDialogAsync<NewRoomDialog>(dialogData, parameters);
        DialogResult? result = await dialog.Result;

        if (!result.Cancelled)
        {
            var resultData = result.Data as NewRoomDialogData;
            nextRoom = resultData?.Room;

            if (nextRoom is null)
            {
                return null;
            }

            if (!nextRoom.HasDimensions)
            {
                ToastService.ShowToast(ToastIntent.Warning, "The room dimensions were not rolled, so the room was not added.");
                nextRoom = null;
                return null;
            }

            // Define the entrance door, then place the room so its entrance door
            // is drawn on top of the selected exit door from the current room.

            @* Char entranceWall = directionFrom.ToString()[0]; *@
            GameTurn.SetDungeonEntranceDoor(nextRoom!, directionFrom, currentRoom!.Id, entranceDoorType);
            GameTurn.AssignExits(nextRoom!, directionFrom, nextRoom.LockRoll);

            var (originX, originY) = MapTools.GetRoomOriginForDoorGridPosition(nextRoom!, directionFrom, entranceDoorX, entranceDoorY);
            nextRoom.CoordX = originX;
            nextRoom.CoordY = originY;
            
            var roomIdTest = nextRoom!.Id;

            await MapTools.DrawRoom(JSRuntime, nextRoom);
            return roomIdTest;
        }
        else{
            nextRoom = null;
        }
        return null;
    }

    private async Task RenderCanvas()
    {
        await MapTools.RefreshCanvas(JSRuntime);
    }

    private async Task RefreshCanvas()
    {
        await FillCanvas();
    }

    // Viewport panning methods
    private async Task PanMap(string direction)
    {
        await MapTools.PanViewport(JSRuntime, direction);
        await RefreshCanvas();
        if (nextRoom != null)
        {
            await MapTools.DrawRoom(JSRuntime, nextRoom);
        }
    }

    private async Task CenterOnCurrentRoom()
    {
        if (currentRoom != null)
        {
            // Center on the middle of the current room
            int centerX = currentRoom.CoordX + (currentRoom.Width / 2);
            int centerY = currentRoom.CoordY + (currentRoom.Height / 2);
            await MapTools.CenterViewportOn(JSRuntime, centerX, centerY);
            await RefreshCanvas();
            if (nextRoom != null)
            {
                await MapTools.DrawRoom(JSRuntime, nextRoom);
            }
        }
    }

    private async Task ResetPan()
    {
        await MapTools.ResetViewport(JSRuntime);
        await RefreshCanvas();
        if (nextRoom != null)
        {
            await MapTools.DrawRoom(JSRuntime, nextRoom);
        }
    }

    private async Task MoveRoom(string direction)
    {
        if (currentRoom == null || !isEditingRoom) return;
        
        switch (direction)
        {
            case "UP":
                currentRoom.CoordY -= 1;
                break;
            case "DOWN":
                currentRoom.CoordY += 1;
                break;
            case "LEFT":
                currentRoom.CoordX -= 1;
                break;
            case "RIGHT":
                currentRoom.CoordX += 1;
                break;
        }

        await RefreshCanvas();
    }


    private async Task AddRoomToDungeon()
    {
        if (nextRoom == null) return;
        
        currentAdventure!.Dungeon.AddRoom(nextRoom);
        currentAdventure!.Dungeon.ChangeRoom(currentRoom!, nextRoom);
        currentAdventure.AppendRoomEntryJournal(nextRoom);
        currentRoom = nextRoom;

        await SaveAventure();

        nextRoom = null;
        await RefreshCanvas();
    }

    private async Task EditRoom()
    {
        if (currentRoom == null) return;

        if (isEditingRoom)
        {
            await StopEditingRoom();
        }
        else
        {
            roomSnapshot = System.Text.Json.JsonSerializer.Deserialize<MappedRoom>(
                System.Text.Json.JsonSerializer.Serialize(currentRoom));
            isEditingRoom = true;
        }
    }

    private async Task CancelEditingRoom()
    {
        if (currentRoom != null && roomSnapshot != null)
        {
            currentRoom.CoordX = roomSnapshot.CoordX;
            currentRoom.CoordY = roomSnapshot.CoordY;
            currentRoom.Width = roomSnapshot.Width;
            currentRoom.Height = roomSnapshot.Height;
            currentRoom.ExitsCount = roomSnapshot.ExitsCount;
            currentRoom.Exits = roomSnapshot.Exits;
        }

        roomSnapshot = null;
        doorErrorMessage = null;
        isEditingRoom = false;
        await RefreshCanvas();
    }

    private List<DoorIssue> GetDoorIssues() =>
        currentRoom == null ? new List<DoorIssue>() : currentAdventure!.Dungeon.ValidateDoors(currentRoom);

    /// <summary>Saves and leaves edit mode, unless a door is invalid; returns whether editing stopped.</summary>
    private async Task<bool> StopEditingRoom()
    {
        var issues = GetDoorIssues();
        if (issues.Count > 0)
        {
            doorErrorMessage = "Fix these doors before finishing, or Cancel:\n" + string.Join("\n", issues.Select(i => i.Message));
            return false;
        }

        doorErrorMessage = null;
        isEditingRoom = false;
        roomSnapshot = null;
        await SaveAventure();
        await RefreshCanvas();
        return true;
    }

    private static readonly Direction[] doorWalls = { Direction.North, Direction.East, Direction.South, Direction.West };

    private int GetWallLength(Direction wall) => currentRoom!.GetWallLength(wall);

    private async Task ResizeRoom(int deltaWidth, int deltaHeight)
    {
        if (currentRoom == null || !isEditingRoom) return;

        var (minW, maxW) = currentRoom.GetWidthRange();
        var (minH, maxH) = currentRoom.GetHeightRange();
        currentRoom.Width = Math.Clamp(currentRoom.Width + deltaWidth, minW, maxW);
        currentRoom.Height = Math.Clamp(currentRoom.Height + deltaHeight, minH, maxH);

        await RefreshCanvas();
    }

    private async Task AddDoor(Direction wall)
    {
        if (currentRoom == null || !isEditingRoom || !currentRoom.CanAddDoor(wall)) return;

        currentRoom.AddDoor(wall);
        await RefreshCanvas();
    }

    private async Task RemoveDoor(Direction wall)
    {
        if (currentRoom == null || !isEditingRoom || !currentRoom.RemoveDoor(wall)) return;

        await RefreshCanvas();
    }

    private async Task MoveDoor(Direction wall, int step)
    {
        if (currentRoom?.Exits == null || !currentRoom.Exits.TryGetValue(wall, out var exit)) return;

        var newPosition = Math.Clamp(exit.PositionOnWall + step, 1, GetWallLength(wall));
        if (newPosition == exit.PositionOnWall) return;

        exit.PositionOnWall = newPosition;
        await RefreshCanvas();
    }


    private async Task FillCanvas()
    {
        await RenderCanvas();
        var rooms = currentAdventure!.Dungeon.GetRooms();

        // Step 1: Draw all rooms first
        foreach (var room in rooms)
        {
            // Here to help debugging an intermittent issue with drawing rooms
            Console.WriteLine($"Drawing Room Id: {room.Id} at X:{room.CoordX} Y:{room.CoordY} Height:{room.Height}" +
                              $" Width:{room.Width} YouAreHere:{room.YouAreHere}");
            int gidX = room.CoordX;
            int gidY = room.CoordY;
            await JSRuntime.InvokeVoidAsync("DrawRoom", gidX, gidY, room.Width, room.Height, room.YouAreHere, room.IsUnique);
        }

        // Step 2: Draw all doors on top
        foreach (var room in rooms)
        {
            if (room.Exits != null)
            {
                await MapTools.DrawDoors(JSRuntime, room, room.YouAreHere);
            }
        }
    }
    FluentAccordionItem? changed;
    private void HandleOnAccordionItemChange(FluentAccordionItem item)
    {
        changed = item;
    }


    private async Task SaveAventure()
    {
        await d6Service.AdventureSave(currentAdventure!);
        ToastService.ShowToast(ToastIntent.Success, "Adventure saved!");
    }

    private async Task AppendJournalEntry(string entry)
    {
        currentAdventure?.AppendJournal(entry);
        await SaveAventure();
    }
